# Контекст сборки для Dockerfile.bot (компонент cutebot на DigitalOcean).
# Образу нужны только main.py, bot/, b_Eden/ и медиа, которые бот реально
# открывает в рантайме: assets/ (advertisingcute.mp4, рассылка.jpg),
# car/ и house/ (bot/funcs/shopvir.py и Gelicopter.py собирают путь как
# "<имя машины>.PNG" и читают файл с диска).
#
# ВАЖНО: этот файл не влияет на компоненты api и bots — у них source_dir=/server,
# то есть свой контекст сборки и свой server/.dockerignore.

# --- VCS: самое тяжёлое в контексте (история репозитория ~125 МБ) ---
.git
.gitignore
.gitattributes

# --- Фронтенд: боту не нужен ничего из этого ---
admin/
src/
public/
dist/
node_modules/
index.html
vite.config.js
tailwind.config.js
postcss.config.js
package.json
package-lock.json
server.js

# --- Загрузки пользователей: бот только ПИШЕТ сюда (main.py::SAVE_DIR),
# читать оттуда он не умеет. Саму папку оставляем — без неё main.py на старте
# ругается "[ERROR] Папка не найдена". ---
reviews/*
!reviews/.gitkeep

# --- Секреты: .env в образ не тащим. Telethon-сессии юзерботов — исключение:
# main_userbot_session.session и withdraw_userbot_session.session ДОЛЖНЫ
# попадать в образ cutebot (force-add в git + deploy_on_push). Без них
# is_user_authorized=False и выводы мертвы. Остальные *.session режем.
#
# Префикс **/ обязателен: без него docker применяет шаблон ТОЛЬКО к корню
# контекста. ---
**/.env
**/.env.*
!.env.example
**/*.session
**/*.session-journal
**/*.session-shm
**/*.session-wal
**/*.session.corrupt-*
!main_userbot_session.session
!withdraw_userbot_session.session

# --- Локальные данные и мусор (в git их нет, но локальный build их подхватит:
# один только bot/db_create/*.db весит 58 МБ) ---
**/*.db
**/*.sqlite
**/*.sqlite3
pkl_backups/
**/logs/
log.txt
log_*.txt
**/venv/
**/.venv/
**/__pycache__/
**/*.py[cod]

# --- Разработка и инструменты ---
docs/
**/tests/
.idea/
.cursor/
.claude/
.playwright-mcp/
.superpowers/
**/.pytest_cache/
**/*.md
**/*.bat
**/*.ps1
