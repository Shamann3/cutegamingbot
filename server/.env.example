# === СЕРВЕР + БАЗА ===
# Скопируй: copy .env.example .env
# НЕ коммить .env в git!

# ============================================================
# РЕЖИМ:
#   test = локальная postgres :5432
#   main = CuteHost cutebase через SSH :15432
# Запуск main: start-main.bat
# ============================================================
APP_MODE=test
MAIN_DB_TARGET=remote

# --- TEST (local, no SSH; empty password = trust on localhost) ---
DB_HOST_TEST=127.0.0.1
DB_PORT_TEST=5432
DB_NAME_TEST=postgres
DB_USER_TEST=postgres
DB_PASSWORD_TEST=
DB_SSL_TEST=false

# --- MAIN (CuteHost SSH) ---
DB_HOST_MAIN=127.0.0.1
DB_PORT_MAIN=15432
DB_NAME_MAIN=cutebase
DB_USER_MAIN=postgres
DB_PASSWORD_MAIN="your_cutehost_postgres_password"
DB_SSL_MAIN=false

SSH_HOST=207.154.219.208
SSH_USER=root
SSH_TUNNEL_PORT=15432

# Managed DB на хостинге (только main):
# DATABASE_URL_MAIN=postgresql://...

# --- Telegram: игровой бот + Web App фермы ---
BOT_TOKEN=
WEBAPP_URL=https://your-ngrok-url.ngrok-free.dev

# URL панели команды (staff.html) — открывается командой /staff в игровом боте
# Пример: https://your-ngrok-url.ngrok-free.dev/panel/staff.html
STAFF_WEBAPP_URL=

# --- Telegram: admin-бот (ОТДЕЛЬНЫЙ бот из @BotFather) ---
ADMIN_BOT_TOKEN=
ADMIN_WEBAPP_URL=https://your-ngrok-url.ngrok-free.dev/panel/

# --- Локальная разработка ---
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_FRONTEND_ORIGIN=http://localhost:5174
# ALLOW_DEV_AUTH и PRODUCTION выставляются из APP_MODE автоматически
MAINTENANCE_MODE=false

# --- Продакшен (DigitalOcean App Platform) ---
# APP_MODE=main
# FRONTEND_ORIGIN=https://your-game.ondigitalocean.app
# WEBAPP_URL=https://your-game.ondigitalocean.app
# DB_SSL_MAIN=true

# initData Telegram (сек): после истечения — перезайти в Web App
INIT_DATA_MAX_AGE=3600
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=80

# Онлайн: окно активности (сек) и интервал снимков
ONLINE_WINDOW_SECONDS=30
ONLINE_SNAPSHOT_INTERVAL_SECONDS=60

# Кэш каталога биржи (сек). 30–60 рекомендуется. 0 = без кэша.
SHOP_CATALOG_CACHE_SECONDS=45

# Ферма: интервал полива (сек). 300 = 5 минут.
# WATER_INTERVAL_SECONDS=300

# Экономика семян (genesis-магазин + дроп + старт + ежедневка)
# HARVEST_SEED_DROP_PERCENT=25
# STARTER_TREE_SEEDS=2
# STARTER_TOBACCO_SEEDS=2
# STARTER_WATER=2
# STARTER_AXE=2
# DAILY_SEED_AMOUNT=1

# --- Admin panel ---
ADMIN_ENABLED=true
# Telegram user_id админов через запятую (обязательно!)
ADMIN_USER_IDS=123456789
# Длинный случайный ключ для владельцев (openssl rand -hex 24). На проде weak-ключи блокируют старт.
# Для кандидатов per-user инвайты в разделе Стафф → Инвайты.
ADMIN_LOGIN_KEY=
# JWT для сессии (openssl rand -hex 32). На проде ≥32 символов.
ADMIN_JWT_SECRET=
ADMIN_SESSION_MINUTES=60

# --- Логи покупок и баланса в Telegram-группу ---
AUDIT_LOG_ENABLED=false
AUDIT_TELEGRAM_CHAT_ID=
AUDIT_TELEGRAM_THREAD_ID=

# Ошибки — отдельная тема в той же группе
ERROR_REPORT_ENABLED=false
ERROR_TELEGRAM_CHAT_ID=
ERROR_TELEGRAM_THREAD_ID=

# --- Frontend (корень проекта, .env) ---
# VITE_API_URL=https://your-api.ondigitalocean.app
# VITE_ADMIN_API_PREFIX=https://your-api.ondigitalocean.app/admin/api
# VITE_DEV_USER_ID=
# VITE_ONLINE_PING_MS=20000
