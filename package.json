{
  "name": "cute-farming",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "concurrently -n game,admin -c green,cyan \"vite\" \"npm run dev --prefix admin\"",
    "dev:game": "vite",
    "dev:admin": "npm run dev --prefix admin",
    "build": "vite build && npm --prefix admin run build",
    "build:game": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "preview:telegram": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "start": "node server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "lottie-web": "^5.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
