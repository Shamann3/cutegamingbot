# ============================================================
# ЕДИНЫЙ ИСТОЧНИК КОНФИГУРАЦИИ ВСЕГО СТЕКА (бот + WebApp + admin + боты)
#
# ГЛАВНЫЙ ПЕРЕКЛЮЧАТЕЛЬ базы — в bot/config/config.py:
#   DATABASE_MODE     = "main" | "test"     (какая база)
#   DATABASE_LOCATION = "remote" | "local"  (где: сервер CuteHost / локально)
#
# Все ЗНАЧЕНИЯ и СЕКРЕТЫ (БД, SSH, токены, admin, CORS, ферма) — ТОЛЬКО здесь,
# в корневом .env. server/.env — пустая заглушка и ничего не переопределяет.
#
# Запуск: python main.py  (бот)  |  сервер: server/ (uvicorn)
# ============================================================

# Запасные переключатели (используются, если строка в config.py пустая ""):
APP_MODE=test
DB_LOCATION=remote
MAIN_DB_TARGET=remote

# Куда онбординг ведёт играть по умолчанию. Если не задано - берётся
# ONBOARDING_CLUB из bot/funcs/onboarding.py (по умолчанию auto = по DATABASE_MODE).
#   auto | test (-1002135149822) | prod (@CuteGamingChat)
# ONBOARDING_CLUB=auto

DB_DEBUG=true
DB_TUNNEL_WAIT_SEC=120
DB_POOL_MIN=1
DB_POOL_MAX=20
SSH_AUTO_TUNNEL=true
SSH_TUNNEL_START_TIMEOUT=20

# === REDIS (кэш/снапшоты — нужен для скорости) ===
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_REQUIRED=false

# === БАЗА ДАННЫХ ===
# ГДЕ база (host/port) — по РАСПОЛОЖЕНИЮ; ЧТО за база (name/user/pass) — по ПРОФИЛЮ.
# Приоритет: DB_<KEY>_<PROFILE>_<LOCATION> → DB_<KEY>_<PROFILE|LOCATION> → дефолт.

# --- РАСПОЛОЖЕНИЕ ---
DB_HOST_LOCAL=127.0.0.1
DB_PORT_LOCAL=5432
DB_HOST_REMOTE=127.0.0.1
DB_PORT_REMOTE=15432

# --- ПРОФИЛЬ TEST ---
DB_NAME_TEST=cutebase
DB_USER_TEST=postgres
DB_PASSWORD_TEST=your_password_here

# --- ПРОФИЛЬ MAIN ---
DB_NAME_MAIN=cutebase
DB_USER_MAIN=postgres
DB_PASSWORD_MAIN=your_password_here

# === SSH CuteHost (для start-main.bat / plink) ===
SSH_HOST=207.154.219.208
SSH_USER=root
SSH_PORT=22
SSH_TUNNEL_PORT=15432
SSH_REMOTE_PG_PORT=5432
SSH_TUNNEL_REMOTE_HOST=127.0.0.1
SSH_PASSWORD=your_ssh_password_here
SSH_USE_KEY=false

# === WEBAPP / СЕРВЕР (раньше было в server/.env — теперь единый источник) ===
BOT_TOKEN=your_webapp_bot_token_here
WEBAPP_URL=https://your-domain.example

ADMIN_ENABLED=true
# Admin-бот (отдельный от BOT_TOKEN): кнопка панели + initData регистрации
ADMIN_BOT_TOKEN=your_admin_bot_token_here
# Numeric id admin-бота (до «:»); пусто = не проверять при старте
ADMIN_BOT_EXPECTED_ID=8630275843
ADMIN_WEBAPP_URL=https://your-domain.example/panel/
ADMIN_USER_IDS=111111111,222222222
ADMIN_LOGIN_KEY=your_admin_login_key_here
# TOTP: окно ±N×30 сек при проверке кода (4 ≈ ±2 мин рассинхрон часов)
ADMIN_TOTP_VALID_WINDOW=4
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_SESSION_MINUTES=60

SUPPORT_BOT_TOKEN=your_support_bot_token_here
SUPPORT_BOT_URL=https://t.me/your_support_bot

PRIVATE_MODE=
PRIVATE_USER_IDS=

PORT=8000
UVICORN_WORKERS=1
FRONTEND_ORIGIN=https://your-domain.example
ADMIN_FRONTEND_ORIGIN=http://localhost:5173
MAINTENANCE_MODE=false

INIT_DATA_MAX_AGE=3600
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=80

AUDIT_LOG_ENABLED=false
AUDIT_TELEGRAM_CHAT_ID=
AUDIT_TELEGRAM_THREAD_ID=

ERROR_REPORT_ENABLED=false
ERROR_TELEGRAM_CHAT_ID=
ERROR_TELEGRAM_THREAD_ID=

# ============================================================
# МЯГКИЙ ПЕРЕЗАПУСК БОТА (soft restart)
# ============================================================
# Процесс завершается (exit 0) → Docker/DO поднимают ТОТ ЖЕ образ.
# Код с git не обновляется. Нужен restart-policy у контейнера (unless-stopped).
#
# Команды owner в Telegram:
#   sypherrestart help | status | now
#
# Сначала проверка:
BOT_SOFT_RESTART_ENABLED=0
BOT_SOFT_RESTART_TEST=1
# Потом бой (вместо двух строк выше):
# BOT_SOFT_RESTART_ENABLED=1
# BOT_SOFT_RESTART_TEST=0
BOT_SOFT_RESTART_INTERVAL_SEC=3600
BOT_SOFT_RESTART_INITIAL_DELAY_SEC=3600
BOT_SOFT_RESTART_GRACE_SEC=3

# ============================================================
# МЯГКИЙ ПЕРЕЗАПУСК ПРОЦЕССА БОТА (soft restart)
# ============================================================
# Бот завершает процесс (exit 0) → Docker/DO поднимают ТОТ ЖЕ образ.
# Код с git не обновляется. Нужно «проветрить» процесс раз в час.
#
# Команды в Telegram (owner / ADMIN_IDS):
#   sypherrestart help | status | now
#
# Сначала проверка: ENABLED=0, TEST=1 → status → now → бот ожил?
# Потом бой:        ENABLED=1, TEST=0  → авто раз в INTERVAL_SEC
# ============================================================
BOT_SOFT_RESTART_ENABLED=0
BOT_SOFT_RESTART_TEST=1
BOT_SOFT_RESTART_INTERVAL_SEC=3600
BOT_SOFT_RESTART_INITIAL_DELAY_SEC=3600
BOT_SOFT_RESTART_GRACE_SEC=3
