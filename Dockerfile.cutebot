# Образ для main.py (@CuteGamingBot + telethon-юзерботы) на DigitalOcean.
# Multi-stage: компилятор (build-essential) остаётся только в builder —
# финальный образ легче, а повторные деплои кэшируют тяжёлый pip-слой.
FROM python:3.12-slim AS builder

WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-bot.txt ./
# --no-deps: requirements-bot.txt — полный слепок рабочего venv (все версии
# уже зафиксированы). Без --no-deps pip упирается в конфликты
# (googletrans↔python-telegram-bot по httpx).
RUN pip install --prefix=/install --no-cache-dir --no-deps -r requirements-bot.txt


FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# runtime: SSL + locales (main.py::locale.setlocale) + redis-server.
# Без build-essential — образ заметно меньше и быстрее пушится в registry.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates locales redis-server \
    && sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local
# Includes main_userbot_session.session + withdraw_userbot_session.session
# (allowlisted in .dockerignore). Without them withdraw userbot stays unauthorized.
COPY . .
RUN chmod +x /app/entrypoint-bot.sh \
    && test -f /app/main_userbot_session.session \
    && test -f /app/withdraw_userbot_session.session \
    && echo "[build] userbot sessions present in image"

ENTRYPOINT ["/app/entrypoint-bot.sh"]
CMD ["python", "-u", "main.py"]
